<?xml version="1.0" encoding="UTF-8"?>
<?page title="OMAC Hour Logger"?>
<zk>
	<?link rel="shortcut icon" type="image/x-icon" href="favicon.ico"?>
	<style>
		@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=DM+Sans:wght@300;400;500;600&amp;display=swap');

		* { box-sizing: border-box; margin: 0; padding: 0; }

		body, .z-window {
		background: #0a0a0a;
		font-family: 'DM Sans', sans-serif;
		color: #f0f0f0;
		min-height: 100vh;
		}

		.shell {
		display: grid;
		grid-template-columns: 260px 1fr;
		min-height: 100vh;
		}

		/* Sidebar */
		.sidebar {
		background: #111111;
		border-right: 1px solid #1f1f1f;
		display: flex;
		flex-direction: column;
		padding: 0;
		}

		.logo-area {
		height: 80px;
		background: #cc0000;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Bebas Neue', sans-serif;
		font-size: 28px;
		letter-spacing: 4px;
		color: #ffffff;
		border-bottom: 3px solid #ff2222;
		}

		.logo-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Bebas Neue', sans-serif;
		font-size: 22px;
		letter-spacing: 3px;
		color: #ffffff;
		}

		.user-panel {
		padding: 24px 20px;
		border-bottom: 1px solid #1f1f1f;
		}

		.user-avatar {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: #cc0000;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Bebas Neue', sans-serif;
		font-size: 22px;
		color: white;
		margin-bottom: 12px;
		}

		.user-name {
		font-size: 15px;
		font-weight: 600;
		color: #ffffff;
		margin-bottom: 4px;
		}

		.user-level {
		font-size: 11px;
		font-weight: 500;
		color: #cc0000;
		text-transform: uppercase;
		letter-spacing: 1px;
		}

		.user-id {
		font-size: 11px;
		color: #555;
		margin-top: 2px;
		}

		.nav-section {
		padding: 20px 12px;
		flex: 1;
		}

		.nav-label {
		font-size: 10px;
		font-weight: 600;
		color: #444;
		text-transform: uppercase;
		letter-spacing: 2px;
		padding: 0 8px;
		margin-bottom: 8px;
		}

		.nav-item {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		border-radius: 6px;
		font-size: 13px;
		font-weight: 500;
		color: #888;
		cursor: pointer;
		margin-bottom: 2px;
		transition: all 0.15s;
		}

		.nav-item:hover, .nav-item.active {
		background: #1a1a1a;
		color: #ffffff;
		}

		.nav-item.active {
		border-left: 3px solid #cc0000;
		color: #ff4444;
		}

		/* Main content */
		.main {
		display: flex;
		flex-direction: column;
		background: #0a0a0a;
		}

		.topbar {
		height: 80px;
		border-bottom: 1px solid #1a1a1a;
		display: flex;
		align-items: center;
		padding: 0 36px;
		gap: 16px;
		}

		.topbar-title {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 26px;
		letter-spacing: 2px;
		color: #ffffff;
		flex: 1;
		}

		.content-area {
		padding: 36px;
		flex: 1;
		}

		/* Cards */
		.card {
		background: #111111;
		border: 1px solid #1f1f1f;
		border-radius: 12px;
		padding: 28px;
		margin-bottom: 24px;
		}

		.card-title {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 18px;
		letter-spacing: 2px;
		color: #cc0000;
		margin-bottom: 20px;
		padding-bottom: 12px;
		border-bottom: 1px solid #1f1f1f;
		}

		/* Login area */
		.login-wrap {
		max-width: 420px;
		margin: 80px auto;
		}

		.login-heading {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 48px;
		letter-spacing: 4px;
		color: #ffffff;
		margin-bottom: 8px;
		}

		.login-sub {
		font-size: 13px;
		color: #555;
		margin-bottom: 36px;
		}

		/* Inputs */
		.z-textbox, .z-doublebox, .z-datebox input, .z-selectbox {
		background: #1a1a1a !important;
		border: 1px solid #2a2a2a !important;
		border-radius: 6px !important;
		color: #f0f0f0 !important;
		padding: 10px 14px !important;
		font-family: 'DM Sans', sans-serif !important;
		font-size: 13px !important;
		width: 100% !important;
		transition: border-color 0.2s !important;
		}

		.z-textbox:focus, .z-doublebox:focus, .z-datebox input:focus {
		border-color: #cc0000 !important;
		outline: none !important;
		}

		.field-label {
		font-size: 11px;
		font-weight: 600;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 6px;
		}

		.field-wrap {
		margin-bottom: 16px;
		}

		/* Buttons */
		.z-button {
		background: #cc0000 !important;
		color: #ffffff !important;
		border: none !important;
		border-radius: 6px !important;
		padding: 10px 24px !important;
		font-family: 'DM Sans', sans-serif !important;
		font-size: 13px !important;
		font-weight: 600 !important;
		cursor: pointer !important;
		letter-spacing: 0.5px !important;
		transition: background 0.2s !important;
		}

		.z-button:hover {
		background: #ff2222 !important;
		}

		.btn-ghost {
		background: transparent !important;
		border: 1px solid #2a2a2a !important;
		color: #888 !important;
		}

		.btn-ghost:hover {
		border-color: #cc0000 !important;
		color: #cc0000 !important;
		background: transparent !important;
		}

		/* Graph */
		.graph-card {
		background: #111111;
		border: 1px solid #1f1f1f;
		border-radius: 12px;
		padding: 28px;
		overflow-x: auto;
		}

		/* Divider */
		.divider {
		height: 1px;
		background: #1f1f1f;
		margin: 20px 0;
		}

		/* Badge */
		.badge {
		display: inline-block;
		background: #1a0000;
		color: #ff4444;
		border: 1px solid #330000;
		border-radius: 4px;
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 3px 8px;
		}

		.two-col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		}

		.section-hint {
		font-size: 12px;
		color: #444;
		margin-bottom: 20px;
		}
	</style>

	<window apply="org.zkoss.bind.BindComposer"
			viewModel="@id('vm')@init('OMAC_Webapp.viewmodel.MyViewModel')"
			border="none" width="100%">

		<!-- LOGIN VIEW -->
		<div visible="@load(!vm.userFound)" style="background:#0a0a0a;min-height:100vh;padding:40px;">
			<div class="login-wrap">
				<div style="font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:4px;color:#cc0000;margin-bottom:16px;">OMAC AMBULANCE SERVICE</div>
				<div class="login-heading">HOUR TRACKER</div>
				<div class="login-sub">Sign in with your OMAC ID to continue</div>

				<div class="card">
					<div class="field-wrap">
						<div class="field-label">OMAC ID</div>
						<textbox value="@bind(vm.omacId)" width="100%"/>
					</div>
					<button label="Sign In" onClick="@command('lookupUser')" width="100%"/>

					<div class="divider"/>

					<div style="font-size:12px;color:#555;margin-bottom:12px;">Don't have an account?</div>
					<button label="Create Account" onClick="@command('toggleRegister')" sclass="btn-ghost" width="100%"/>
				</div>

				<!-- Register form -->
				<div class="card" visible="@load(vm.showRegister)">
					<div class="card-title">NEW ACCOUNT</div>
					<div class="two-col">
						<div class="field-wrap">
							<div class="field-label">First Name</div>
							<textbox value="@bind(vm.newFirstName)" width="100%"/>
						</div>
						<div class="field-wrap">
							<div class="field-label">Last Name</div>
							<textbox value="@bind(vm.newLastName)" width="100%"/>
						</div>
					</div>
					<div class="field-wrap">
						<div class="field-label">OMAC ID</div>
						<textbox value="@bind(vm.newOmacId)" width="100%"/>
					</div>
					<div class="field-wrap">
						<div class="field-label">Level</div>
						<selectbox model="@load(vm.levels)" value="@bind(vm.newLevel)" width="100%">
							<template name="model">
								<label value="@load(each)"/>
							</template>
						</selectbox>
					</div>
					<button label="Register" onClick="@command('registerUser')" width="100%"/>
				</div>
			</div>
		</div>

		<!-- DASHBOARD VIEW -->
		<div visible="@load(vm.userFound)" class="shell">

			<!-- Sidebar -->
			<div class="sidebar">
				<div class="logo-area">
					<image src="omac.png" style="max-height:60px;max-width:220px;object-fit:contain;"/>
				</div>

				<div class="user-panel">
					<div class="user-avatar">
						<label value="@load(vm.currentUser.firstName.substring(0,1))"/>
					</div>
					<div class="user-name">
						<label value="@load(vm.currentUser.firstName.concat(' ').concat(vm.currentUser.lastName))"/>
					</div>
					<div class="user-level">
						<label value="@load(vm.currentUser.level)"/>
					</div>
					<div class="user-id">
						<label value="@load(('ID: ').concat(vm.currentUser.omacId))"/>
					</div>
				</div>

				<div class="nav-section">
					<div class="nav-label">Menu</div>
					<div class="nav-item active">&#x23F0; Log Hours</div>
					<div class="nav-item">&#x1F464; My Details</div>
				</div>
			</div>

			<!-- Main -->
			<div class="main">
				<div class="topbar">
					<div class="topbar-title">HOUR TRACKER</div>
					<div class="badge">OMAC</div>
				</div>

				<div class="content-area">

					<!-- Overview -->
					<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:24px;">
						<div class="card" style="margin-bottom:0;text-align:center;">
							<div style="font-size:11px;font-weight:600;color:#555;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;">This Week</div>
							<div style="font-family:'Bebas Neue',sans-serif;font-size:48px;color:#cc0000;line-height:1;">
								<label value="@load(vm.hoursThisWeek)"/>
							</div>
							<div style="font-size:11px;color:#444;margin-top:6px;">HOURS</div>
						</div>
						<div class="card" style="margin-bottom:0;text-align:center;">
							<div style="font-size:11px;font-weight:600;color:#555;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;">This Month</div>
							<div style="font-family:'Bebas Neue',sans-serif;font-size:48px;color:#cc0000;line-height:1;">
								<label value="@load(vm.hoursThisMonth)"/>
							</div>
							<div style="font-size:11px;color:#444;margin-top:6px;">HOURS</div>
						</div>
						<div class="card" style="margin-bottom:0;text-align:center;">
							<div style="font-size:11px;font-weight:600;color:#555;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;">This Year</div>
							<div style="font-family:'Bebas Neue',sans-serif;font-size:48px;color:#cc0000;line-height:1;">
								<label value="@load(vm.hoursThisYear)"/>
							</div>
							<div style="font-size:11px;color:#444;margin-top:6px;">HOURS</div>
						</div>
					</div>

					<!-- Log Hours Card -->
					<div class="card">
						<div class="card-title">LOG HOURS</div>
						<div class="section-hint">Record your service hours below</div>
						<div class="two-col">
							<div class="field-wrap">
								<div class="field-label">Date</div>
								<datebox value="@bind(vm.logDate)" width="100%"/>
							</div>
							<div class="field-wrap">
								<div class="field-label">Hours</div>
								<doublebox value="@bind(vm.hours)" width="100%"/>
							</div>
						</div>
						<div class="field-wrap">
							<div class="field-label">Description</div>
							<textbox value="@bind(vm.description)" width="100%" rows="3"/>
						</div>
						<hlayout spacing="10px">
							<button label="Submit" onClick="@command('submitLog')"/>
							<button label="Clear" onClick="@command('clearForm')" sclass="btn-ghost"/>
						</hlayout>
					</div>

					<!-- Graph Card -->
					<div class="graph-card">
						<hlayout style="align-items:center;margin-bottom:20px;">
							<div class="card-title" style="margin-bottom:0;border-bottom:none;flex:1;">HOURS</div>
							<selectbox model="@load(vm.yearOptions)" selectedIndex="@load(vm.selectedYearIndex)" width="100px"
									   onSelect="@command('changeYear', year=self.model.getElementAt(self.selectedIndex))">
								<template name="model">
									<label value="@load(each)"/>
								</template>
							</selectbox>
						</hlayout>
						<html content="@load(vm.graphHtml)"/>
					</div>

				</div>
			</div>
		</div>

	</window>
</zk>